# Qualquer conta Google verificada pode entrar; sessão salva por até 90 dias.
AUTH_REQUIRED=true
# Auth.js (necessário apenas com AUTH_REQUIRED=true)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# OpenAI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Google Sheets (Service Account)
GOOGLE_SERVICE_ACCOUNT_EMAIL=
# Cole a chave com \n literais, entre aspas
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
SPREADSHEET_ID=
SHEET_NAME=lancaNota
CONTROL_SHEET_NAME=_controle
